        "id": "where-state-lives",
        "label": "Where the state lives",
        "focus": [
          "worktarget",
          "db",
          "corpora"
        ],
        "note": "Three stores, three jobs. A key for what is being worked on, SurrealDB for the canonical entities, and an on-disk mirror of every write."

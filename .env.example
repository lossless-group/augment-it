

ANTHROPIC_API_KEY=your_api_key_here
OPENAI_API_KEY=your_api_key_here
PERPLEXITY_API_KEY=your_api_key_here
JINA_API_KEY=your_api_key_here
FIRECRAWL_API_KEY=your_api_key_here
# Optional for services/social-search. The common-seven social packs default to
# the self-hosted SearXNG container (no key needed). Only packs explicitly routed
# to the Tavily connector — content-RAG packs — need this. Get a key at
# https://tavily.com.
TAVILY_API_KEY=your_api_key_here
# Required for the Entity Pulse `official-blog-pack` (find-index stage uses
# SerpApi `engine: 'google'` with `site:` restriction). Get a key at
# https://serpapi.com. The social-search service starts without this; only
# packs that route through SerpApi error if it's missing.
SERPAPI_API_KEY=your_api_key_here
# Optional — secret for the internal-only SearXNG container. A dev default is
# baked into docker-compose; override here if you want a non-default value.
SEARXNG_SECRET=augment-it-local-dev-secret

# ── SurrealDB Cloud (canonical entity layer) ───────────────────────────────
# All five below are REQUIRED by every scripts/surreal-*.mjs writer and by the
# person-enrichment micro-frontend. The browser build embeds these at build
# time (rsbuild source.define) — DEV-ONLY, single-operator; a proxy service
# replaces this before any shared/public deploy. See the blueprint:
# context-v/blueprints/Connecting-To-And-Using-SurrealDB.md
SURREAL_URL=wss://your-instance.surreal.cloud
SURREAL_NS=main
SURREAL_DB=main
SURREAL_USER=your_db_user
SURREAL_PASS=your_db_password
# Workspace slug that tags every canonical write (per the Client-Tagging spec).
# Scripts hard-fail without it (or a --client arg); the browser build defaults
# to "reach-edu" when unset. Set the client you're actively serving, or leave
# blank and pass --client <slug> per script run when bouncing between clients.
SURREAL_CLIENT=reach-edu

# ── Corpus backup / sync (Cloudflare R2 + the lossless-core JuiceFS volume) ─
# Not currently wired into any script — reference-only, per
# context-v/explorations/JuiceFS-Pinned-Path-Off-Local-Substrate.md.
#
# Why these live here AND in ~/.secrets (redundant on purpose): local dev
# agents and agent harnesses (e.g. Claude Code) only get automatic filesystem
# access within a project's own working tree — not to a laptop-wide dotfile
# like ~/.secrets outside it. To let an agent (or a new human contributor)
# working inside augment-it/ sync or back up corpus files without first being
# told "the real keys are at ~/.secrets", a project-scoped copy is kept here
# too. ~/.secrets stays canonical — if you rotate one copy, rotate both, or
# this silently goes stale the same way the JINA_API_KEY / JINA_AI_API_KEY
# mismatch did.
JUICEFS_LOSSLESS_TOKEN=your_juicefs_token_here
R2_ACCESS_KEY_ID=your_r2_access_key_id_here
R2_SECRET_ACCESS_KEY=your_r2_secret_access_key_here
CLOUDFLARE_ACCOUNT_ID=your_cloudflare_account_id_here
CLOUDFLARE_R2_API_ENDPOINT=https://your_account_id.r2.cloudflarestorage.com/lossless-core
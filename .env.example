

ANTHROPIC_API_KEY=your_api_key_here
OPENAI_API_KEY=your_api_key_here
PERPLEXITY_API_KEY=your_api_key_here
JINA_AI_API_KEY=your_api_key_here
FIRECRAWL_API_KEY=your_api_key_here
# Optional for services/social-search. The common-seven social packs default to
# the self-hosted SearXNG container (no key needed). Only packs explicitly routed
# to the Tavily connector — content-RAG packs — need this. Get a key at
# https://tavily.com.
TAVILY_API_KEY=your_api_key_here
# Required for the Entity Pulse `official-blog-pack` (find-index stage uses
# SerpApi `engine: 'google'` with `site:` restriction). Get a key at
# https://serpapi.com. The social-search service starts without this; only
# packs that route through SerpApi error if it's missing.
SERPAPI_API_KEY=your_api_key_here
# Optional — secret for the internal-only SearXNG container. A dev default is
# baked into docker-compose; override here if you want a non-default value.
SEARXNG_SECRET=augment-it-local-dev-secret